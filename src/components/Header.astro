---
import { SITE_TITLE } from "../consts";
import SiteIcon from "../assets/Avatar.webp";
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
---

<header>
	<nav>
		<h2>
			<a href="/"
				><Image
					src={SiteIcon}
					alt={SITE_TITLE}
					loading="eager"
					fetchpriority="high"
				/>{SITE_TITLE}</a
			>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/" icon="tabler:home">Home</HeaderLink>
			<HeaderLink href="/services" icon="tabler:server"
				>Services</HeaderLink
			>
			<HeaderLink href="/about" icon="tabler:user">About</HeaderLink>
		</div>
		<div class="theme-switch">
			<ThemeSwitch />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}

	h2 a img {
		width: 2em;
		height: 2em;
		object-fit: cover;
		border-radius: 50%;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.theme-switch {
		display: flex;
		align-items: center;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
<script>
	// Header 位于 swup 的交换容器之外，页面切换后不会被重新渲染，
	// 所以导航高亮（active）需要在前端根据当前路径动态更新。
	const BASE_URL = import.meta.env.BASE_URL;

	function syncActiveLinks() {
		const pathname = location.pathname.replace(BASE_URL, "");
		const subpath = pathname.match(/[^/]+/g);
		const root = "/" + (subpath?.[0] || "");

		document
			.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
			.forEach((a) => {
				const href = a.getAttribute("href") ?? "/";
				const isActive = href === pathname || href === root;
				a.classList.toggle("active", isActive);
			});
	}

	// 首次加载也同步一次，保证与 SSR 输出一致
	syncActiveLinks();

	// swup 完成页面内容替换后重新计算高亮
	document.addEventListener("swup:page:view", syncActiveLinks);
</script>
