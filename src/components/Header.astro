---
import { SITE_TITLE } from "../consts";
import SiteIcon from "../assets/Avatar.webp";
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
---

<header>
	<nav>
		<h2>
			<a href="/"
				><Image
					src={SiteIcon}
					alt={SITE_TITLE}
					loading="eager"
					fetchpriority="high"
				/></a
			>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="theme-switch">
			<ThemeSwitch />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}

	h2 a img {
		width: 2em;
		height: 2em;
		object-fit: cover;
		border-radius: 50%;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.theme-switch {
		display: flex;
		align-items: center;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
